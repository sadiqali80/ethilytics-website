# ----- Titan SMTP (outgoing mail — required for the form to send) -----
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
# SSL/TLS is used automatically on port 465 (secure: true in server.js)
SMTP_USER=info@ethilytics.co.uk     # your full Titan address
SMTP_PASS=                            # your Titan password — set this yourself, never commit it

# Optional: the visible "From" address, if it differs from SMTP_USER — e.g. when
# relaying through a Gmail account that has info@ethilytics.co.uk verified as a
# "Send mail as" alias. Falls back to SMTP_USER if unset.
# MAIL_FROM=info@ethilytics.co.uk

# Where demo requests are emailed (can equal SMTP_USER)
NOTIFY_TO=info@ethilytics.co.uk

# Optional: where job applications are emailed instead. Falls back to NOTIFY_TO if unset.
# CAREERS_NOTIFY_TO=info@ethilytics.co.uk

# App
PORT=3000

# ----- Optional: Cloudflare Turnstile (spam protection) -----
# TURNSTILE_SECRET=

# ----- Titan IMAP (incoming mail — NOT used by this form; for your mail client only) -----
# IMAP_HOST=imap.titan.email
# IMAP_PORT=993
# IMAP_ENCRYPTION=SSL/TLS
